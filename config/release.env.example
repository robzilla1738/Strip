# Copy to config/release.env and replace each placeholder.
# Scripts never invent these values. An unset value (empty or still {{NAME}})
# prints MISSING: {{NAME}} and the release path stays in dry-run.
# Do not commit config/release.env.

APP_NAME={{APP_NAME}}
BUNDLE_ID={{BUNDLE_ID}}
URL_SCHEME={{URL_SCHEME}}
APPLE_TEAM_ID={{APPLE_TEAM_ID}}
DEVELOPER_ID_APPLICATION={{DEVELOPER_ID_APPLICATION}}
ASC_KEY_ID={{ASC_KEY_ID}}
ASC_ISSUER_ID={{ASC_ISSUER_ID}}
ASC_KEY_P8_PATH={{ASC_KEY_P8_PATH}}
NOTARY_PROFILE={{NOTARY_PROFILE}}
SPARKLE_PUBLIC_ED_KEY={{SPARKLE_PUBLIC_ED_KEY}}
SPARKLE_PRIVATE_KEY_PATH={{SPARKLE_PRIVATE_KEY_PATH}}
APPCAST_URL={{APPCAST_URL}}
UPDATE_HOST_UPLOAD={{UPDATE_HOST_UPLOAD}}
DODO_ENV={{DODO_ENV}}
DODO_PRODUCT_ID_1={{DODO_PRODUCT_ID_1}}
DODO_PRODUCT_ID_3={{DODO_PRODUCT_ID_3}}
DODO_PRODUCT_ID_5={{DODO_PRODUCT_ID_5}}
DODO_PRODUCT_ID_20={{DODO_PRODUCT_ID_20}}
DODO_CHECKOUT_URL={{DODO_CHECKOUT_URL}}
TRIAL_DAYS={{TRIAL_DAYS}}
SUPPORT_EMAIL={{SUPPORT_EMAIL}}
WEBSITE_URL={{WEBSITE_URL}}
APP_ICON_1024_PNG={{APP_ICON_1024_PNG}}
